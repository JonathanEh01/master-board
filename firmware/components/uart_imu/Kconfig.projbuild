    default 8192 if IMU_BNO08X_MOUNT_X_DOWN_Y_WEST_Z_NORTH
    default -11585 if IMU_BNO08X_MOUNT_X_EAST_Y_DOWN_Z_NORTH
    default 8192 if IMU_BNO08X_MOUNT_X_UP_Y_WEST_Z_SOUTH
    default 0 if IMU_BNO08X_MOUNT_X_WEST_Y_DOWN_Z_SOUTH
    default 8192 if IMU_BNO08X_MOUNT_X_DOWN_Y_EAST_Z_SOUTH
    default 11585 if IMU_BNO08X_MOUNT_X_EAST_Y_UP_Z_SOUTH

